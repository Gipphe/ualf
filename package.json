{
  "name": "ualf",
  "description": "LLPS/CGLSS (UALF) data parser",
  "version": "3.1.2",
  "license": "MIT",
  "homepage": "https://github.com/Gipphe/ualf",
  "bugs": "https://github.com/Gipphe/ualf/issues",
  "engines": {
    "node": ">=16"
  },
  "author": {
    "name": "Victor Nascimento Bakke",
    "email": "gipphe@gmail.com",
    "url": "http://giphtbase.org/"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/Gipphe/ualf.git"
  },
  "keywords": [
    "ulaf",
    "llps",
    "cglss",
    "lightning",
    "string",
    "parser",
    "parse"
  ],
  "files": [
    "dist/*"
  ],
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && ./fixup.sh",
    "clean": "rm -rf dist/*",
    "test": "c8 --reporter text --reporter lcov --reporter html ava",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "ava": "^7.0.0",
    "c8": "^7.13.0",
    "eslint": "^8.57.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
